/* ========================================================================= */
/* style.qss - DubInstante 2026 Light UI — Purple-led Design System         */
/* ========================================================================= */

/* Tokens (from dubinstante-design-system)
   bg:             #fafafb  (neutral-50)
   surface:        #ffffff  (neutral-0)
   surface-sunk:   #f4f4f6  (neutral-100)
   surface-hover:  #f4f4f6  (neutral-100)
   fg1:            #121217  (neutral-900)
   fg2:            #3a3a42  (neutral-700)
   fg3:            #7a7a85  (neutral-500)
   fg4:            #a8a8b2  (neutral-400)
   border:         #e9e9ed  (neutral-200)
   border-strong:  #d6d6dc  (neutral-300)
   border-focus:   #7c56f5  (purple-500)
   accent:         #7c56f5  (purple-500)
   accent-hover:   #6838e0  (purple-600)
   accent-press:   #5627bb  (purple-700)
   accent-soft:    #f6f3ff  (purple-50)
   accent-soft-2:  #ece4ff  (purple-100)
   on-accent:      #ffffff
   danger:         #e2344d
   danger-bg:      #fde6ea
   success:        #0ea66b
   warning:        #d98b00
*/

QWidget {
    font-family: "Inter Tight", "Segoe UI", "SF Pro Text", sans-serif;
    color: #121217;
}

QMainWindow,
QWidget#CentralWidget {
    background-color: #fafafb;
}

/*
 * QMenuBar styling is intentionally omitted.
 * On macOS, styling QMenuBar via QSS forces Qt to use a non-native
 * widget-based menu bar, which causes the system menu bar to disappear.
 * On Linux/Windows, the Fusion style + palette provides good defaults.
 */


QMenu {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #f6f3ff;
    color: #5627bb;
}

QMenu::separator {
    height: 1px;
    background: #e9e9ed;
    margin: 4px 2px;
}

QMenu QWidget {
    background: #ffffff;
    color: #121217;
}

QMenu QLabel {
    background: transparent;
    color: #7a7a85;
}

QMenu QPushButton {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 28px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QMenu QPushButton:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
}

QMenu QPushButton:pressed {
    background: #e9e9ed;
}

/* Video area remains neutral and untouched structurally */
QFrame#videoFrame {
    background-color: #000000;
    border: none;
}

/* Control panel */
QWidget#controlBar {
    background-color: #ffffff;
    border: none;
    border-radius: 10px;
}

QWidget#controlBar QLabel {
    background: transparent;
    color: #3a3a42;
    font-size: 12px;
    font-weight: 500;
}

QLabel#timecodeLabel {
    font-family: "JetBrains Mono", "Consolas", monospace;
    color: #7c56f5;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QLabel[cssClass="control-label"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

/* Buttons: no hard borders on control surfaces */
QWidget#controlBar QPushButton,
QFrame[cssClass="track"] QPushButton {
    border: none;
    background: transparent;
    color: #3a3a42;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#controlBar QPushButton[class="btn"] {
    background: transparent;
    color: #3a3a42;
}

QWidget#controlBar QPushButton[class="btn"]:hover {
    background: #f4f4f6;
}

QWidget#controlBar QPushButton[class="btn"]:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton[cssClass="stepButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 0;
    font-size: 16px;
    font-weight: 700;
    min-width: 28px;
}

QWidget#controlBar QPushButton[cssClass="stepButton"]:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
    color: #121217;
}

QWidget#controlBar QPushButton[cssClass="stepButton"]:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton[cssClass="resetButton"] {
    background: #ece4ff;
    color: #5627bb;
    border: 1px solid #d9ccff;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#controlBar QPushButton[cssClass="resetButton"]:hover {
    background: #d9ccff;
    border: 1px solid #bca7ff;
}

QWidget#controlBar QPushButton[cssClass="iconButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 3px;
}

QWidget#controlBar QPushButton[cssClass="iconButton"]:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
}

QWidget#controlBar QPushButton#volumeMuteButton:checked {
    background: #fde6ea;
    border: 1px solid #e2344d;
}

QWidget#controlBar QPushButton#btnPlayPause {
    background: #121217;
    color: #ffffff;
    border-radius: 10px;
    padding: 9px 14px;
}

QWidget#controlBar QPushButton#btnPlayPause:hover {
    background: #23232a;
}

QWidget#controlBar QPushButton#btnPlayPause:pressed {
    background: #3a3a42;
}

QWidget#controlBar QPushButton#btnStop {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #d6d6dc;
    border-radius: 10px;
    padding: 9px 12px;
}

QWidget#controlBar QPushButton#btnStop:hover {
    background: #f4f4f6;
    border: 1px solid #a8a8b2;
}

QWidget#controlBar QPushButton#btnStop:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton#recordButton {
    background: #fde6ea;
    color: #e2344d;
    border-radius: 8px;
    font-weight: 700;
}

QWidget#controlBar QPushButton#recordButton:hover {
    background: #f9c4cd;
}

QWidget#controlBar QPushButton#recordButton:checked {
    background: #e2344d;
    color: #ffffff;
}

/* Inputs — hide built-in spinbox arrows (custom +/- buttons exist) */
QWidget#controlBar QSpinBox::up-button,
QWidget#controlBar QSpinBox::down-button,
QWidget#controlBar QDoubleSpinBox::up-button,
QWidget#controlBar QDoubleSpinBox::down-button {
    width: 0;
    border: none;
}

QSpinBox,
QDoubleSpinBox,
QComboBox {
    background: #fafafb;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 26px;
    padding: 3px 10px;
    font-size: 12px;
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border: 1px solid #d6d6dc;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #7c56f5;
    background: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    selection-background-color: #7c56f5;
    selection-color: #ffffff;
}

QCheckBox {
    color: #7a7a85;
    font-size: 11px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d6d6dc;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #7c56f5;
    border: 1px solid #7c56f5;
}

/* Sliders */
QSlider {
    min-height: 18px;
}

QSlider::groove:horizontal {
    border: none;
    background: #e9e9ed;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #7c56f5;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #7c56f5;
    width: 12px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    border: 2px solid #6838e0;
}

/* Mixer area */
QWidget#mixerZone {
    background: transparent;
    border: none;
}

QFrame[cssClass="track"] {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
}

QFrame[cssClass="track"] QLabel[cssClass="track-header-title"] {
    color: #121217;
    font-size: 13px;
    font-weight: 600;
}

QFrame[cssClass="track"] QPushButton[cssClass="track-header-btn"] {
    border: none;
    background: transparent;
    color: #a8a8b2;
    border-radius: 6px;
    padding: 2px;
}

QFrame[cssClass="track"] QPushButton[cssClass="track-header-btn"]:hover {
    background: #f4f4f6;
    color: #7a7a85;
}

QFrame[cssClass="track"] QFrame[cssClass="track-header-line"] {
    background: #e9e9ed;
    min-height: 1px;
    max-height: 1px;
    border: none;
}

QFrame[cssClass="track"] QLabel[cssClass="track-control-label"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

QFrame[cssClass="track"] QComboBox[cssClass="track-control-select"] {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    color: #121217;
    font-size: 12px;
    padding: 3px 8px;
}

QFrame[cssClass="track"] QSlider[cssClass="track-control-slider"] {
    min-height: 20px;
}

QFrame[cssClass="track"] QFrame[cssClass="track-vu"] {
    background: #121217;
    border-radius: 6px;
}

QFrame[cssClass="track"] QFrame[cssClass="vu-bg"] {
    background: #23232a;
    border-radius: 3px;
}

QFrame[cssClass="track"] QFrame[cssClass="vu-fill"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0ea66b,
                                stop:0.70 #0ea66b,
                                stop:0.88 #d98b00,
                                stop:1 #e2344d);
    border-radius: 3px;
}

/* Progress */
QProgressBar {
    border: none;
    border-radius: 6px;
    background: #e9e9ed;
    color: #3a3a42;
    height: 18px;
    text-align: center;
}

QProgressBar::chunk {
    background: #7c56f5;
    border-radius: 6px;
}

/* Track settings dialog & Global Settings Dialog & Shortcuts Dialog & Export Settings Dialog */
QDialog#trackSettingsDialog,
QDialog#globalSettingsDialog,
QDialog#exportSettingsDialog {
    background: #fafafb;
}

QDialog#trackSettingsDialog QLabel#settingsDialogTitle,
QDialog#globalSettingsDialog QLabel#settingsDialogTitle,
QDialog#exportSettingsDialog QLabel#settingsDialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: #121217;
}

QDialog#trackSettingsDialog QLabel#settingsDialogSubtitle,
QDialog#globalSettingsDialog QLabel#settingsDialogSubtitle,
QDialog#exportSettingsDialog QLabel#settingsDialogSubtitle {
    font-size: 12px;
    color: #7a7a85;
    margin-bottom: 2px;
}

QDialog#trackSettingsDialog QFrame#settingsCardTrackSelector,
QDialog#globalSettingsDialog QFrame#settingsCard,
QDialog#exportSettingsDialog QFrame#settingsCard {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
}

QDialog#trackSettingsDialog QLabel[cssClass="settingsLabel"],
QDialog#globalSettingsDialog QLabel[cssClass="settingsLabel"],
QDialog#exportSettingsDialog QLabel[cssClass="settingsLabel"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
    margin-right: 6px;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"],
QDialog#globalSettingsDialog QPushButton[cssClass="settingsTabButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"]:hover,
QDialog#globalSettingsDialog QPushButton[cssClass="settingsTabButton"]:hover {
    background: #f4f4f6;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"]:checked,
QDialog#globalSettingsDialog QPushButton[cssClass="settingsTabButton"]:checked {
    background: #ece4ff;
    color: #5627bb;
    border: 1px solid #d9ccff;
}

QDialog#trackSettingsDialog QGroupBox,
QDialog#globalSettingsDialog QGroupBox,
QDialog#exportSettingsDialog QGroupBox {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    margin-top: 12px;
    font-size: 12px;
    font-weight: 600;
    color: #3a3a42;
}

QDialog#trackSettingsDialog QGroupBox::title,
QDialog#globalSettingsDialog QGroupBox::title,
QDialog#exportSettingsDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    color: #7a7a85;
    background: #ffffff;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"],
QDialog#globalSettingsDialog QPushButton[cssClass="presetButton"],
QDialog#exportSettingsDialog QPushButton[cssClass="presetButton"] {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"]:hover,
QDialog#globalSettingsDialog QPushButton[cssClass="presetButton"]:hover,
QDialog#exportSettingsDialog QPushButton[cssClass="presetButton"]:hover {
    background: #f4f4f6;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"]:pressed,
QDialog#globalSettingsDialog QPushButton[cssClass="presetButton"]:pressed,
QDialog#exportSettingsDialog QPushButton[cssClass="presetButton"]:pressed {
    background: #e9e9ed;
}

QDialog#globalSettingsDialog QPushButton[cssClass="presetButton"][capturing="true"] {
    background-color: #ece4ff;
    color: #5627bb;
    border: 1px solid #7c56f5;
}

QDialog#globalSettingsDialog QPushButton[cssClass="shortcutClearButton"] {
    background: #f1f1f4;
    color: #7a7a85;
    border: none;
    border-radius: 15px;
    font-size: 16px;
    font-weight: bold;
    padding: 0px;
}

QDialog#globalSettingsDialog QPushButton[cssClass="shortcutClearButton"]:hover {
    background: #fee2e2;
    color: #ef4444;
}

QDialog#globalSettingsDialog QPushButton[cssClass="shortcutClearButton"]:pressed {
    background: #fca5a5;
    color: #dc2626;
}

QDialog#trackSettingsDialog QLabel[cssClass="fineLabel"],
QDialog#globalSettingsDialog QLabel[cssClass="fineLabel"],
QDialog#exportSettingsDialog QLabel[cssClass="fineLabel"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QFontComboBox,
QDialog#trackSettingsDialog QSpinBox,
QDialog#globalSettingsDialog QComboBox,
QDialog#globalSettingsDialog QSpinBox,
QDialog#globalSettingsDialog QLineEdit,
QDialog#globalSettingsDialog QListWidget,
QDialog#exportSettingsDialog QComboBox,
QDialog#exportSettingsDialog QSpinBox,
QDialog#exportSettingsDialog QLineEdit {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 28px;
    padding: 4px 10px;
}

QDialog#trackSettingsDialog QFontComboBox:hover,
QDialog#trackSettingsDialog QSpinBox:hover,
QDialog#globalSettingsDialog QComboBox:hover,
QDialog#globalSettingsDialog QSpinBox:hover,
QDialog#globalSettingsDialog QLineEdit:hover,
QDialog#globalSettingsDialog QListWidget:hover,
QDialog#exportSettingsDialog QComboBox:hover,
QDialog#exportSettingsDialog QSpinBox:hover,
QDialog#exportSettingsDialog QLineEdit:hover {
    border: 1px solid #d6d6dc;
}

QDialog#trackSettingsDialog QFontComboBox:focus,
QDialog#trackSettingsDialog QSpinBox:focus,
QDialog#globalSettingsDialog QComboBox:focus,
QDialog#globalSettingsDialog QSpinBox:focus,
QDialog#globalSettingsDialog QLineEdit:focus,
QDialog#globalSettingsDialog QListWidget:focus,
QDialog#exportSettingsDialog QComboBox:focus,
QDialog#exportSettingsDialog QSpinBox:focus,
QDialog#exportSettingsDialog QLineEdit:focus {
    border: 1px solid #7c56f5;
}

QDialog#trackSettingsDialog QPushButton[cssClass="colorPickerButton"] {
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

/* Settings Dialog Buttons */
QDialog#trackSettingsDialog QPushButton#settingsCloseButton,
QDialog#globalSettingsDialog QPushButton#settingsSaveButton,
QDialog#exportSettingsDialog QPushButton#settingsExportButton {
    background: #7c56f5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton#settingsCloseButton:hover,
QDialog#globalSettingsDialog QPushButton#settingsSaveButton:hover,
QDialog#exportSettingsDialog QPushButton#settingsExportButton:hover {
    background: #6838e0;
}

QDialog#trackSettingsDialog QPushButton#settingsCloseButton:pressed,
QDialog#globalSettingsDialog QPushButton#settingsSaveButton:pressed,
QDialog#exportSettingsDialog QPushButton#settingsExportButton:pressed {
    background: #5627bb;
}

QDialog#globalSettingsDialog QPushButton#settingsCancelButton {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #d6d6dc;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#globalSettingsDialog QPushButton#settingsCancelButton:hover {
    background: #f4f4f6;
    border: 1px solid #c8c8cf;
}

QDialog#globalSettingsDialog QPushButton#settingsCancelButton:pressed {
    background: #e9e9ed;
}

/* Tab Widget Styling for Export Dialog (Light Theme) */
QTabWidget#expertTabWidget::pane {
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    background: #ffffff;
}

QTabWidget#expertTabWidget QTabBar::tab {
    background: #fafafb;
    color: #7a7a85;
    padding: 6px 12px;
    border: 1px solid #e9e9ed;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    margin-right: 4px;
}

QTabWidget#expertTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #5627bb;
    border: 1px solid #e9e9ed;
    border-bottom: 1px solid #ffffff;
}

QTabWidget#expertTabWidget QTabBar::tab:hover:!selected {
    background: #f4f4f6;
    color: #121217;
}

QTabWidget#expertTabWidget QWidget {
    background: #ffffff;
}

/* Beautiful Minimalist Scrollbar (Light Theme) */
QDialog#globalSettingsDialog QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QDialog#globalSettingsDialog QScrollBar::handle:vertical {
    background: #d1d5db;
    min-height: 30px;
    border-radius: 3px;
}

QDialog#globalSettingsDialog QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

QDialog#globalSettingsDialog QScrollBar::add-line:vertical,
QDialog#globalSettingsDialog QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QDialog#globalSettingsDialog QScrollBar::up-arrow:vertical,
QDialog#globalSettingsDialog QScrollBar::down-arrow:vertical {
    background: none;
}

QDialog#globalSettingsDialog QScrollBar::add-page:vertical,
QDialog#globalSettingsDialog QScrollBar::sub-page:vertical {
    background: none;
}

/* Stepper style */
QPushButton[cssClass="stepButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 0;
    font-size: 16px;
    font-weight: 700;
    min-width: 28px;
    min-height: 28px;
}

QPushButton[cssClass="stepButton"]:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
    color: #121217;
}

QPushButton[cssClass="stepButton"]:pressed {
    background: #e9e9ed;
}

QLabel#countdownValueLabel {
    font-size: 13px;
    font-weight: bold;
    min-width: 90px;
    color: #121217;
}

.warning-text {
    color: #d98b00;
    font-size: 11px;
    font-weight: 600;
    padding: 4px;
}

QLabel#countdownLabel {
    color: #7c56f5;
    font-size: 80px;
    font-weight: bold;
    background-color: rgba(244, 244, 246, 0.85);
    border-radius: 20px;
}

/* QMessageBox Theming */
QMessageBox {
    background-color: #ffffff;
    color: #1f2937;
}

QMessageBox QLabel {
    color: #1f2937;
    font-size: 13px;
}

QMessageBox QPushButton {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #d6d6dc;
    border-radius: 6px;
    padding: 5px 12px;
    min-width: 70px;
}

QMessageBox QPushButton:hover {
    background: #f4f4f6;
}

QMessageBox QPushButton:pressed {
    background: #e9e9ed;
}

/* Record Arm Button — Armed (checked) */
QFrame[cssClass="track"] QPushButton#recordArmButton:checked {
    background: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 11px;
}

/* Record Arm Button — Disarmed (unchecked) */
QFrame[cssClass="track"] QPushButton#recordArmButton {
    background: #e9e9ed;
    color: #7a7a85;
    border: 1px solid #d6d6dc;
    border-radius: 6px;
    font-weight: 600;
    font-size: 11px;
}

QFrame[cssClass="track"] QPushButton#recordArmButton:hover {
    background: #dcdce2;
}

/* Recording State Labels */
QLabel#recordingStateLabel[state="recording"] {
    color: #ef4444;
    font-weight: 700;
    font-size: 10px;
}

QLabel#recordingStateLabel[state="playing"] {
    color: #22c55e;
    font-weight: 700;
    font-size: 10px;
}

/* Post-Record Notification Bar */
QWidget#postRecordBar {
    background: #ece4ff;
    border-bottom: 1px solid #d9ccff;
}



